# Secretos de las Edge Functions. En producción: `supabase secrets set NOMBRE=valor`.
# NUNCA los pongas en el frontend ni en el repositorio.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Clave (32 bytes en base64) para cifrar los tokens de X en la tabla x_accounts.
X_TOKEN_ENCRYPTION_KEY=
# true = no llama a la API de X, devuelve datos falsos.
X_MOCK=true

# Copia este fichero a .env.local y rellena los valores.
# NUNCA subas valores reales al repositorio.

# Supabase (Project Settings → API). La anon key es pública por diseño; la seguridad la da RLS.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Modo mock de X: true = datos falsos, sin llamar a la API de X (no gasta créditos).
VITE_X_MOCK=true

# Botones de acceso rápido con las cuentas demo del seed (SOLO desarrollo local; nunca en producción).
VITE_DEMO_ACCOUNTS=false
